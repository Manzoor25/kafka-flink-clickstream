          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-rt" },
          "format": 2,
          "queryType": "sql",
          "rawSql": "SELECT toStartOfInterval(event_ts, INTERVAL 5 SECOND) AS time, uniqExact(user_id) AS \"Active Users\", countIf(event_type = 'view') AS \"Views\", countIf(event_type = 'add_to_cart') AS \"Add to Cart\", countIf(event_type = 'checkout') AS \"Checkout\", countIf(event_type = 'purchase') AS \"Purchases\" FROM analytics.clicks_enriched FINAL WHERE $__timeFilter(event_ts) GROUP BY time ORDER BY time ASC",
