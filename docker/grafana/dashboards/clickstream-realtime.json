      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-rt" },
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT Stage, Journeys FROM (WITH f AS (SELECT sum(step_1_views) AS s1, sum(step_2_carts) AS s2, sum(step_3_checkouts) AS s3, sum(step_4_purchases) AS s4 FROM analytics.funnel_window_metrics FINAL), live AS (SELECT uniqExactIf(client_session_id, event_type = 'view') AS l1, uniqExactIf(client_session_id, event_type = 'add_to_cart') AS l2, uniqExactIf(client_session_id, event_type = 'checkout') AS l3, uniqExactIf(client_session_id, event_type = 'purchase') AS l4 FROM analytics.clicks_enriched FINAL) SELECT '1. Product View' AS Stage, if((SELECT s1 FROM f) > 0, (SELECT s1 FROM f), (SELECT l1 FROM live)) AS Journeys UNION ALL SELECT '2. Add to Cart', if((SELECT s1 FROM f) > 0, (SELECT s2 FROM f), (SELECT l2 FROM live)) UNION ALL SELECT '3. Checkout', if((SELECT s1 FROM f) > 0, (SELECT s3 FROM f), (SELECT l3 FROM live)) UNION ALL SELECT '4. Purchase', if((SELECT s1 FROM f) > 0, (SELECT s4 FROM f), (SELECT l4 FROM live))) ORDER BY Stage ASC",
          "refId": "A"
        }
      ],
      "title": "4-Step Conversion Funnel (Flink MATCH_RECOGNIZE)",
      "type": "bargauge"
    },
